digraph CurrentDiffusionPolicy {
    graph [
        rankdir=LR,
        bgcolor="white",
        pad="0.14",
        nodesep="0.24",
        ranksep="0.42",
        splines=polyline,
        compound=true,
        newrank=true,
        fontname="Arial",
        fontsize=18,
        labelloc="t",
        label="Multimodal Conditional Diffusion Policy"
    ];

    node [
        shape=box,
        style="rounded,filled",
        color="#4B5563",
        penwidth=1.15,
        fillcolor="#F8FAFC",
        fontname="Arial",
        fontsize=11,
        margin="0.10,0.07"
    ];

    edge [
        color="#4B5563",
        penwidth=1.15,
        arrowsize=0.65,
        fontname="Arial",
        fontsize=9
    ];

    subgraph cluster_observation {
        label="Two-frame multimodal observation encoder";
        color="#93C5FD";
        penwidth=1.3;
        style="rounded";
        fontname="Arial";
        fontsize=13;

        obs_input [
            label="Two observations\nframes t-1 and t",
            fillcolor="#DBEAFE",
            color="#2563EB",
            fontcolor="#1E3A8A"
        ];
        rgb_path [
            label="RGB wrist images\n[3 x 240 x 320] x 2\nResize + ImageNet norm\nRandom crop (90%, training)\nResNet-18 x 2 -> 512D x 2",
            fillcolor="#E0F2FE",
            color="#0284C7"
        ];
        lowdim_path [
            label="Per-frame low-dimensional state\nTCP pose 9D + gripper 1D\nmagnetic tactile 15D\n= 25D per frame",
            fillcolor="#ECFDF5",
            color="#059669"
        ];
        frame_fusion [
            label="Per-frame fusion\n512D visual + 25D state = 537D",
            fillcolor="#DCFCE7",
            color="#16A34A"
        ];
        temporal_fusion [
            label="Temporal concatenation\n2 x 537D = 1074D global condition",
            fillcolor="#FEF3C7",
            color="#D97706",
            penwidth=1.35
        ];

        obs_input -> rgb_path [color="#2563EB"];
        obs_input -> lowdim_path [color="#059669"];
        rgb_path -> frame_fusion [color="#0284C7"];
        lowdim_path -> frame_fusion [color="#059669"];
        frame_fusion -> temporal_fusion [color="#D97706"];
    }

    subgraph cluster_condition {
        label="Diffusion conditioning";
        color="#C4B5FD";
        penwidth=1.3;
        style="rounded";
        fontname="Arial";
        fontsize=13;

        timestep [
            label="Diffusion timestep",
            fillcolor="#F5F3FF",
            color="#7C3AED"
        ];
        time_embedding [
            label="Sinusoidal embedding + MLP\n128D",
            fillcolor="#EDE9FE",
            color="#7C3AED"
        ];
        condition_fusion [
            label="Condition fusion\n1074D observation + 128D time",
            fillcolor="#EDE9FE",
            color="#7C3AED"
        ];
        film [
            label="FiLM modulation\nchannel-wise scale + bias",
            fillcolor="#EDE9FE",
            color="#7C3AED"
        ];

        timestep -> time_embedding [color="#7C3AED"];
        time_embedding -> condition_fusion [color="#7C3AED"];
        condition_fusion -> film [color="#7C3AED"];
    }

    noisy_action [
        label="Noisy action trajectory x_t\n[16 steps x 10D]\n3D position + 6D rotation + gripper",
        fillcolor="#F3E8FF",
        color="#7C3AED",
        penwidth=1.3
    ];

    subgraph cluster_unet {
        label="Conditional 1D U-Net denoiser";
        color="#A78BFA";
        penwidth=1.3;
        style="rounded,dashed";
        fontname="Arial";
        fontsize=13;

        down1 [label="Down block\n512 channels\nConv1D k=5\nGN(8) + Mish", fillcolor="#F5F3FF"];
        down2 [label="Down block\n1024 channels\nConv1D k=5\nGN(8) + Mish", fillcolor="#F5F3FF"];
        bottleneck [label="Bottleneck\n2048 channels\n2 residual blocks", fillcolor="#DDD6FE", color="#7C3AED"];
        up2 [label="Up block\n1024 channels\nResidual + skip", fillcolor="#F5F3FF"];
        up1 [label="Up block\n512 channels\nResidual + skip", fillcolor="#F5F3FF"];
        epsilon [label="Noise prediction\nepsilon_pred [16 x 10]", fillcolor="#EDE9FE", color="#7C3AED"];

        down1 -> down2 [label="downsample"];
        down2 -> bottleneck [label="downsample"];
        bottleneck -> up2 [label="upsample"];
        up2 -> up1 [label="upsample"];
        up1 -> epsilon;
        down1 -> up1 [style=dashed, color="#9CA3AF", label="skip"];
        down2 -> up2 [style=dashed, color="#9CA3AF", label="skip"];
    }

    ddim [
        label="DDIM reverse diffusion\n100 denoising steps\nClean action trajectory [16 x 10]",
        fillcolor="#FFEDD5",
        color="#EA580C",
        fontcolor="#7C2D12",
        penwidth=1.35
    ];
    receding [
        label="Receding-horizon execution\nRe-observe and re-plan at 12 Hz",
        fillcolor="#FEE2E2",
        color="#DC2626",
        fontcolor="#7F1D1D",
        penwidth=1.35
    ];
    output [
        label="10D robot command\nTCP relative action\nAbsolute gripper opening",
        fillcolor="#FECACA",
        color="#DC2626",
        fontcolor="#7F1D1D"
    ];

    temporal_fusion -> condition_fusion [color="#D97706", penwidth=1.35];
    film -> down1 [style=dashed, color="#7C3AED", label="all residual blocks"];
    noisy_action -> down1 [color="#7C3AED", penwidth=1.35];
    epsilon -> ddim [label="epsilon prediction", color="#EA580C", penwidth=1.35];
    ddim -> receding [color="#DC2626", penwidth=1.35];
    receding -> output [color="#DC2626", penwidth=1.35];

    subgraph cluster_training {
        label="Training only";
        color="#CBD5E1";
        penwidth=1.0;
        style="rounded,dashed";
        fontname="Arial";
        fontsize=11;
        demo_action [label="Normalized demo action x_0\n[16 x 10]", fillcolor="#F8FAFC"];
        forward_diffusion [label="Add Gaussian noise\nat random timestep", fillcolor="#F8FAFC"];
        mse [label="MSE loss\n||epsilon_pred - epsilon||^2", fillcolor="#F8FAFC"];
        demo_action -> forward_diffusion -> noisy_action [style=dashed, color="#64748B"];
        epsilon -> mse [style=dashed, color="#64748B"];
        forward_diffusion -> mse [style=dashed, color="#64748B"];
    }
}
